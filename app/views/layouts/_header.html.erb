<header>
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container-fluid">
      <%= link_to "Swing Log", root_path, class: "navbar-brand fw-bold" %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <%= link_to "About", about_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "投稿一覧", posts_path, class: "nav-link" %>
          </li>

          <% if Current.session&.user %>
            <li class="nav-item">
              <%= link_to "マイページ", user_path(Current.session.user), class: "nav-link" %>
            </li>
          <% end %>
        </ul>

        <% if Current.session&.user %>
          <%= render "searches/form" %>

          <%= button_to "ログアウト",
              session_path,
              method: :delete,
              class: "btn btn-outline-light ms-3",
              form: { class: "d-inline" } %>
        <% else %>
          <%= link_to "ログイン", new_session_path, class: "btn btn-outline-light me-2" %>
          <%= link_to "新規登録", new_user_path, class: "btn btn-light" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
