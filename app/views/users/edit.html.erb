<h1>ユーザー情報編集</h1>

<div class="user-form-container">
  <% if @user.errors.any? %>
    <div class="error-messages">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user do |f| %>
    <div class="form-group">
      <%= f.label :name, "ユーザー名", class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :email_address, "メールアドレス", class: "form-label" %>
      <%= f.email_field :email_address, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :introduction, "自己紹介", class: "form-label" %>
      <%= f.text_area :introduction, class: "form-textarea" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード", class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div class="form-actions-left">
      <%= f.submit "更新する", class: "submit-button" %>
    </div>
  <% end %>

  <div class="danger-zone">
    <h2>退会</h2>
    <p>退会するとユーザー情報と投稿が削除されます。</p>

    <div class="orm-actions-left">
      <%= button_to "退会する",
          user_path(@user),
          method: :delete,
          data: { turbo_confirm: "本当に退会しますか？" },
          class: "btn-danger" %>
    </div>
  </div>
</div>
