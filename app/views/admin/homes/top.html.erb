<h1 class="mb-4">管理者トップページ</h1>

<div class="row g-3">
  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">ユーザー数</h5>
        <p class="display-6"><%= @users_count %></p>
        <%= link_to "ユーザー一覧へ", admin_users_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">投稿数</h5>
        <p class="display-6"><%= @posts_count %></p>
        <%= link_to "投稿一覧へ", admin_posts_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title">コメント数</h5>
        <p class="display-6"><%= @comments_count %></p>
        <%= link_to "コメント一覧へ", admin_comments_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
