<h1 class="mb-4">コメント詳細</h1>

<div class="card shadow-sm">
  <div class="card-body">
    <p>
      <strong>投稿：</strong>

      <% if @comment.post.present? %>
        <%= link_to @comment.post.title, admin_post_path(@comment.post) %>
      <% else %>
        削除済みの投稿
      <% end %>
    </p>

    <p>
      <strong>投稿者：</strong>
      <%= @comment.user&.name || "退会済みユーザー" %>
    </p>

    <div class="d-flex align-items-start mb-3">
      <strong class="me-2 flex-shrink-0">コメント：</strong>
      <div><%= simple_format(@comment.body, {}, wrapper_tag: "span") %></div>
    </div>

    <p class="text-muted small">
      投稿日時：
      <%= @comment.created_at.strftime("%Y/%m/%d %H:%M") %>
    </p>

    <%= link_to "コメント一覧へ戻る", admin_comments_path,
          class: "btn btn-secondary" %>

    <%= link_to "削除", admin_comment_path(@comment),
          data: {
            turbo_method: :delete,
            turbo_confirm: "このコメントを削除しますか？"
          },
          class: "btn btn-danger" %>
  </div>
</div>