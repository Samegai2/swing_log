<h1 class="mb-4">ユーザー詳細</h1>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <p><strong>ID：</strong><%= @user.id %></p>
    <p><strong>ユーザー名：</strong><%= @user.name %></p>
    <p><strong>メールアドレス：</strong><%= @user.email_address %></p>
    <p><strong>自己紹介：</strong><%= @user.introduction.presence || "自己紹介はまだありません。" %></p>
    <p><strong>登録日時：</strong><%= l @user.created_at, format: :short %></p>
    <p><strong>更新日時：</strong><%= l @user.updated_at, format: :short %></p>

    <%= link_to "ユーザー一覧へ戻る", admin_users_path, class: "btn btn-secondary" %>

    <%= link_to "削除", admin_user_path(@user),
          data: { turbo_method: :delete, turbo_confirm: "このユーザーを削除しますか？投稿とコメントも削除されます。" },
          class: "btn btn-danger" %>
  </div>
</div>

<h2 class="mb-3">このユーザーの投稿</h2>

<div class="card shadow-sm">
  <div class="card-body">
    <% if @posts.any? %>
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>ID</th>
            <th>タイトル</th>
            <th>施設名</th>
            <th>投稿日時</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.id %></td>
              <td><%= link_to post.title, admin_post_path(post) %></td>
              <td><%= post.facility_name %></td>
              <td><%= l post.created_at, format: :short %></td>
              <td class="text-end">
                <%= link_to "投稿詳細", admin_post_path(post), class: "btn btn-sm btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">投稿はありません。</p>
    <% end %>
  </div>
</div>