<h1 class="mb-4">ユーザー一覧</h1>

<%= form_with url: admin_users_path, method: :get, local: true, class: "row g-2 mb-4" do |f| %>
  <div class="col-md-6">
    <%= f.text_field :q, value: params[:q], placeholder: "ユーザー名・メールアドレスで検索", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= f.submit "検索", class: "btn btn-primary" %>
  </div>
<% end %>

<div class="card shadow-sm">
  <div class="card-body">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>ユーザー名</th>
          <th>メールアドレス</th>
          <th>登録日時</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.id %></td>
            <td><%= link_to user.name, admin_user_path(user) %></td>
            <td><%= user.email_address %></td>
            <td><%= l user.created_at, format: :short %></td>
            <td class="text-end">
              <%= link_to "詳細", admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "削除", admin_user_path(user),
                    data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
