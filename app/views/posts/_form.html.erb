
<div class="post-form-container">

  <% if post.errors.any? %>
    <div class="error-messages">
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: post do |f| %>
    <div class="form-group">
      <%= f.label :title, "タイトル", class: "form-label" %>
      <%= f.text_field :title, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :facility_name, "施設名", class: "form-label" %>
      <%= f.text_field :facility_name, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :address, "住所", class: "form-label" %>
      <%= f.text_field :address, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :play_style, "種別", class: "form-label" %>
      <%= f.select :play_style,
          Post.play_styles_i18n.invert,
          { prompt: "選択してください" },
          class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :score, "スコアまたは打数", class: "form-label" %>
      <%= f.number_field :score, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :body, "感想", class: "form-label" %>
      <%= f.text_area :body, class: "form-textarea" %>
    </div>

    <div class="form-group">
      <%= f.label :image, "施設写真", class: "form-label" %>
      <%= f.file_field :image, class: "form-file" %>
    </div>

    <div class="form-actions-left">
      <%= f.submit post.persisted? ? "更新する" : "投稿する", class: "submit-button" %>
    </div>
  <% end %>
</div>